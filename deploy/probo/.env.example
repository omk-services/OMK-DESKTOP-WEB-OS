# .env.example — variables d'environnement pour Probo sur Render
#
# Ce fichier est un AIDE-MÉMOIRE pour remplir les variables dans
# dashboard.render.com, pas un fichier à copier tel quel. Render
# injecte les valeurs au déploiement — rien n'est versionné.

# URL publique du service (renseignée après le premier déploiement)
APP_URL=https://coach-os-probo.onrender.com

# Hôtes autorisés pour Probo (CSRF / sécurité). Mêmes valeurs que APP_URL.
ALLOWED_HOSTS=coach-os-probo.onrender.com

# Environnement
NODE_ENV=production
PORT=8080

# Optionnel — à décommenter et remplir si vous voulez des emails
# depuis Probo (signature de politique notifiée par mail, etc.)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Optionnel — décommenter pour autoriser Coach OS à embarquer Probo
# dans une iframe. Par défaut Probo refuse (X-Frame-Options: DENY) —
# c'est plus sûr, et Coach OS propose un lien d'ouverture externe.
# X_FRAME_OPTIONS_DENY=false