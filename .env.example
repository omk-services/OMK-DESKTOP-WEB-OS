# Supabase (backend)
#
# Deux projets cibles selon le regime de demonstration (cf. SOCLE) :
#
#   OMK SERVICES INTERN     — Architecte + compte de demonstration
#                             ref sgzbkhqqkqdwhakkyzzm  /  omk-internal (multi-tenant)
#                             URL : https://sgzbkhqqkqdwhakkyzzm.supabase.co
#
#   OMK SERVICES CUSTOMERS  — Clients coachs niveau 1 (PoC avant SaaS)
#                             ref ndvqwcapwcnpdvknxcjw  /  omk-customers (multi-tenant)
#                             URL : https://ndvqwcapwcnpdvknxcjw.supabase.co
#
# Le projet historique coach-os (qjrwcdzaebyqponqkiqs) est EN PAUSE :
# son DNS ne resout plus. Ne JAMAIS le re-pointer — basculer sur INTERN
# ou CUSTOMERS selon le contexte (videos de demo = INTERN).
#
# Le seed local doit survivre au branchement : l'app tourne en demo
# autonome ET en mode connecte. `supabaseConfigured` (src/lib/supabase.ts)
# bascule sur le seed si l'URL manque OU contient "placeholder" OU ne
# commence pas par https://. Un avertissement console explicite est emis
# si l'URL est configuree mais injoignable.
VITE_SUPABASE_URL=https://sgzbkhqqkqdwhakkyzzm.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_ME_WITH_YOUR_SUPABASE_ANON_KEY

# PostHog Cloud (analytics/observability) — https://eu.posthog.com (EU region for RGPD)
# Get project key from PostHog Settings → Project → API Keys
VITE_POSTHOG_KEY=phc_REPLACE_ME_WITH_YOUR_POSTHOG_PROJECT_KEY
VITE_POSTHOG_HOST=https://eu.posthog.com

# UserTour (onboarding) — https://app.usertour.io
# Get token from Settings → Environments
VITE_USERTOUR_TOKEN=ut_REPLACE_ME_WITH_YOUR_USERTOUR_ENV_TOKEN

# UserTour content IDs (one per onboarding flow; set after creating the flow in app.usertour.io)
# T1 fires on the user's first window-open (SOB welcome)
VITE_USERTOUR_CONTENT_WELCOME=
# T2 fires the first time the user lands on People → Overview (first standup)
VITE_USERTOUR_CONTENT_STANDUP=
# T3 fires the first time the user drills into a squad agent
VITE_USERTOUR_CONTENT_SQUAD=
# T4 fires the first time the user opens People → Cadence
VITE_USERTOUR_CONTENT_CADENCE=
# T5 fires the first time the user opens Settings → Privacy
VITE_USERTOUR_CONTENT_PRIVACY=

# RGPD opt-in (must be true to enable SDKs, false = SDKs init but stay opted-out)
VITE_OBSERVABILITY_OPT_IN=false

# --- Model providers (api/chat, server-side only — never VITE_*) ---
# MiniMax-M3 : cle compatible Anthropic, passee via @ai-sdk/anthropic.
# C'est la voie qui ne consomme pas les quotas Anthropic.
MINIMAX_API_KEY=
# Anthropic direct (consomme les quotas, garder en reserve).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=